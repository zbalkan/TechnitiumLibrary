; plain.test - unsigned zone covering answer, referral and wildcard paths.
; SOA and NS are created by the server when the zone is created.
$ORIGIN plain.test.
$TTL 3600
@         IN A      192.0.2.1
@         IN AAAA   2001:db8::1
@         IN MX     10 mail.plain.test.
@         IN TXT    "v=spf1 -all"
@         IN CAA    0 issue "ca.invalid"
@         IN HTTPS  1 . alpn=h2,h3
mail      IN A      192.0.2.2
host      IN A      192.0.2.3
host      IN AAAA   2001:db8::3
; CNAME chain: www -> web -> host
www       IN CNAME  web.plain.test.
web       IN CNAME  host.plain.test.
; DNAME redirection of everything under dname.plain.test
dname     IN DNAME  target.plain.test.
x.target  IN A      192.0.2.4
_sip._udp IN SRV    10 60 5060 host.plain.test.
naptr     IN NAPTR  100 10 "S" "SIP+D2U" "" _sip._udp.plain.test.
svc       IN SVCB   1 host.plain.test. alpn=h2 port=8443 ipv4hint=192.0.2.3
_443._tcp.host IN TLSA 3 1 1 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
host      IN SSHFP  4 2 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
_http._tcp IN URI   10 1 "https://host.plain.test/"
; wildcard with two types
*.wild    IN A      192.0.2.5
*.wild    IN TXT    "wildcard"
; empty non-terminals: ent and b.ent exist only as parents
a.b.ent   IN A      192.0.2.6
; delegation with in-bailiwick glue
child     IN NS     ns1.child.plain.test.
ns1.child IN A      192.0.2.53
; about 3 KB of TXT data, larger than the 1232-byte UDP payload, to force TC
big      IN TXT    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
big      IN TXT    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
big      IN TXT    "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
