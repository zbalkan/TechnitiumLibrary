+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.IO;
+using TechnitiumLibrary.Net.Dns.Dnssec;
+
+namespace DnsServerCore.Dns.Dnssec
+{
+    /// <summary>
+    /// Stores the operator's DNSSEC negative trust anchors and supplies them to the resolver.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// A negative trust anchor suspends DNSSEC validation for a subtree, so this owns the
+    /// obligations RFC 7646 section 5 places on the operator and which the library deliberately
+    /// does not implement - see the caller obligations documented on
+    /// <see cref="INegativeTrustAnchorProvider"/>:
+    /// </para>
+    ///
+    /// <list type="number">
+    /// <item>lifetime is capped at <see cref="MAX_LIFETIME"/>;</item>
+    /// <item>anchors expire on their own and are swept out;</item>
+    /// <item>adding or removing an anchor flushes cached entries at and below its node - on
+    /// addition as well as removal, since already-cached secure records are otherwise unaffected
+    /// until their TTL lapses and the new anchor appears not to work.</item>
+    /// </list>
+    ///
+    /// <para>
+    /// Names are canonicalized through <see cref="NegativeTrustAnchorInfo.TryCanonicalizeName"/>
+    /// on the way in, so what an operator sees listed is exactly what the resolver enforces. Left
+    /// unnormalized, a name typed as <c>EXAMPLE.COM.</c> would be stored verbatim while the
+    /// resolver enforced <c>example.com</c>, and a name the resolver rejects outright would never
+    /// take effect with nothing to show for it.
+    /// </para>
+    /// </remarks>
+    public sealed class NegativeTrustAnchorManager : INegativeTrustAnchorProvider
+    {
+        #region variables
+
+        /// <summary>RFC 7646 section 5: an NTA lifetime "SHOULD NOT exceed a week".</summary>
+        public static readonly TimeSpan MAX_LIFETIME = TimeSpan.FromDays(7);
+
+        readonly DnsServer _dnsServer;
+
+        //Keyed by canonical name. The value is the anchor, so a re-add of the same name replaces
+        //rather than accumulates.
+        readonly ConcurrentDictionary<string, NegativeTrustAnchorEntry> _anchors = new ConcurrentDictionary<string, NegativeTrustAnchorEntry>(StringComparer.Ordinal);
+
+        #endregion
+
+        #region constructor
+
+        public NegativeTrustAnchorManager(DnsServer dnsServer)
+        {
+            _dnsServer = dnsServer;
+        }
+
+        #endregion
+
+        #region public
+
+        /// <summary>
+        /// Adds or replaces an anchor and flushes the cache at and below its node.
+        /// </summary>
+        /// <param name="domain">The zone to suspend validation for; "." or "" for the root.</param>
+        /// <param name="expiresOnUtc">
+        /// When the anchor lapses. Clamped to <see cref="MAX_LIFETIME"/> from now.
+        /// </param>
+        /// <param name="reason">Free-text operator note, for the anchor listing and audit log.</param>
+        /// <returns>The canonical name the anchor was stored under.</returns>
+        /// <exception cref="ArgumentException">The name cannot be used as an anchor.</exception>
+        public string AddNegativeTrustAnchor(string domain, DateTimeOffset expiresOnUtc, string reason = null)
+        {
+            if (!NegativeTrustAnchorInfo.TryCanonicalizeName(domain, out string canonicalName))
+                throw new ArgumentException("The domain name cannot be used as a negative trust anchor: " + domain, nameof(domain));
+
+            DateTimeOffset nowUtc = DateTimeOffset.UtcNow;
+
+            if (expiresOnUtc <= nowUtc)
+                throw new ArgumentException("The negative trust anchor expiry must be in the future.", nameof(expiresOnUtc));
+
+            DateTimeOffset maxExpiry = nowUtc + MAX_LIFETIME;
+            if (expiresOnUtc > maxExpiry)
+                expiresOnUtc = maxExpiry; //RFC 7646 section 5
+
+            _anchors[canonicalName] = new NegativeTrustAnchorEntry(new NegativeTrustAnchorInfo(canonicalName, expiresOnUtc), reason, nowUtc);
+
+            //A newly added anchor has no effect on records already cached as secure until their
+            //TTL lapses, so the subtree is flushed to make it take effect immediately.
+            FlushCacheSubtree(canonicalName);
+
+            return canonicalName;
+        }
+
+        /// <summary>Removes an anchor and flushes the cache at and below its node.</summary>
+        /// <returns><see langword="false"/> when no such anchor was configured.</returns>
+        public bool RemoveNegativeTrustAnchor(string domain)
+        {
+            if (!NegativeTrustAnchorInfo.TryCanonicalizeName(domain, out string canonicalName))
+                return false;
+
+            if (!_anchors.TryRemove(canonicalName, out _))
+                return false;
+
+            //RFC 7646 section 5: "when removing the NTA, the implementation SHOULD remove all
+            //cached entries at and below the NTA node".
+            FlushCacheSubtree(canonicalName);
+
+            return true;
+        }
+
+        /// <summary>Lists the currently active anchors for the operator, most specific first.</summary>
+        public IReadOnlyList<NegativeTrustAnchorEntry> ListNegativeTrustAnchors()
+        {
+            DateTimeOffset nowUtc = DateTimeOffset.UtcNow;
+
+            List<NegativeTrustAnchorEntry> entries = new List<NegativeTrustAnchorEntry>(_anchors.Count);
+
+            foreach (KeyValuePair<string, NegativeTrustAnchorEntry> entry in _anchors)
+            {
+                if (entry.Value.Anchor.ExpiresOnUtc > nowUtc)
+                    entries.Add(entry.Value);
+            }
+
+            entries.Sort(delegate (NegativeTrustAnchorEntry x, NegativeTrustAnchorEntry y)
+            {
+                return y.Anchor.Name.Length.CompareTo(x.Anchor.Name.Length);
+            });
+
+            return entries;
+        }
+
+        /// <summary>
+        /// Drops anchors that have lapsed. Called from the server's maintenance timer.
+        /// </summary>
+        /// <remarks>
+        /// No cache flush accompanies expiry: a record admitted under an anchor carries that
+        /// anchor as provenance, and the cache refuses to serve it once the anchor has lapsed.
+        /// This sweep only keeps the listing honest and bounds the dictionary.
+        /// </remarks>
+        public void RemoveExpiredNegativeTrustAnchors()
+        {
+            DateTimeOffset nowUtc = DateTimeOffset.UtcNow;
+
+            foreach (KeyValuePair<string, NegativeTrustAnchorEntry> entry in _anchors)
+            {
+                if (entry.Value.Anchor.ExpiresOnUtc <= nowUtc)
+                    _anchors.TryRemove(entry);
+            }
+        }
+
+        #endregion
+
+        #region INegativeTrustAnchorProvider
+
+        /// <summary>
+        /// Returns the anchors in force. Called once per logical resolution; must be fast,
+        /// non-blocking and free of side effects.
+        /// </summary>
+        public IReadOnlyCollection<NegativeTrustAnchorInfo> GetActiveAnchors()
+        {
+            if (_anchors.IsEmpty)
+                return Array.Empty<NegativeTrustAnchorInfo>();
+
+            DateTimeOffset nowUtc = DateTimeOffset.UtcNow;
+
+            List<NegativeTrustAnchorInfo> active = new List<NegativeTrustAnchorInfo>(_anchors.Count);
+
+            foreach (KeyValuePair<string, NegativeTrustAnchorEntry> entry in _anchors)
+            {
+                //Filtered here as well as by the sweep, so a lapsed anchor stops suspending
+                //validation the instant it expires rather than at the next maintenance pass.
+                if (entry.Value.Anchor.ExpiresOnUtc > nowUtc)
+                    active.Add(entry.Value.Anchor);
+            }
+
+            return active;
+        }
+
+        #endregion
+
+        #region persistence
+
+        public void WriteTo(BinaryWriter bW)
+        {
+            bW.Write((byte)1); //version
+
+            IReadOnlyList<NegativeTrustAnchorEntry> entries = ListNegativeTrustAnchors();
+
+            bW.Write(entries.Count);
+
+            foreach (NegativeTrustAnchorEntry entry in entries)
+            {
+                bW.Write(entry.Anchor.Name);
+                bW.Write(entry.Anchor.ExpiresOnUtc.UtcDateTime.Ticks);
+                bW.Write(entry.Reason ?? "");
+                bW.Write(entry.CreatedOnUtc.UtcDateTime.Ticks);
+            }
+        }
+
+        public void ReadFrom(BinaryReader bR)
+        {
+            byte version = bR.ReadByte();
+            if (version != 1)
+                throw new InvalidDataException("NegativeTrustAnchorManager format version not supported: " + version);
+
+            _anchors.Clear();
+
+            DateTimeOffset nowUtc = DateTimeOffset.UtcNow;
+            int count = bR.ReadInt32();
+
+            for (int i = 0; i < count; i++)
+            {
+                string name = bR.ReadString();
+                DateTimeOffset expiresOnUtc = new DateTimeOffset(bR.ReadInt64(), TimeSpan.Zero);
+                string reason = bR.ReadString();
+                DateTimeOffset createdOnUtc = new DateTimeOffset(bR.ReadInt64(), TimeSpan.Zero);
+
+                //Anchors that lapsed while the server was down are simply not restored. Re-check
+                //the name too: the canonicalization rules belong to the library and may tighten.
+                if (expiresOnUtc <= nowUtc)
+                    continue;
+
+                if (!NegativeTrustAnchorInfo.TryCanonicalizeName(name, out string canonicalName))
+                    continue;
+
+                _anchors[canonicalName] = new NegativeTrustAnchorEntry(new NegativeTrustAnchorInfo(canonicalName, expiresOnUtc), reason, createdOnUtc);
+            }
+        }
+
+        #endregion
+
+        #region private
+
+        private void FlushCacheSubtree(string canonicalName)
+        {
+            //The root anchor covers everything, so nothing narrower than a full flush will do.
+            if (canonicalName.Length == 0)
+            {
+                _dnsServer.CacheZoneManager.Flush();
+                return;
+            }
+
+            //DeleteZone is a subtree removal - it calls DomainTree.TryRemoveTree - so this covers
+            //"all cached entries at and below the NTA node" as RFC 7646 section 5 asks, not just
+            //the node itself.
+            _dnsServer.CacheZoneManager.DeleteZone(canonicalName);
+        }
+
+        #endregion
+    }
+
+    /// <summary>An active negative trust anchor together with its operator-facing metadata.</summary>
+    public sealed record NegativeTrustAnchorEntry(NegativeTrustAnchorInfo Anchor, string Reason, DateTimeOffset CreatedOnUtc);
+}
