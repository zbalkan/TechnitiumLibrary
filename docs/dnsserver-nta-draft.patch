+        /// <summary>
+        /// Queries the cache, refusing to serve anything whose negative trust anchor has lapsed.
+        /// </summary>
+        /// <remarks>
+        /// <para>
+        /// A record admitted under a negative trust anchor was accepted only because DNSSEC
+        /// validation was suspended for its zone. Once the anchor expires that justification is
+        /// gone, so the record must stop being served rather than wait out its TTL - otherwise the
+        /// anchor's expiry, which is the whole mechanism bounding how long validation stays off,
+        /// has no effect on data already cached.
+        /// </para>
+        ///
+        /// <para>
+        /// The library enforces this inside <c>DnsCache.QueryAsync</c>, but this class overrides
+        /// the query path and stores records in its own tree, so none of that code runs. The check
+        /// is applied here against the same predicate the library uses, rather than a local
+        /// reimplementation that could drift from it. Failing the check yields a cache miss, which
+        /// sends the resolver upstream - by then the anchor is gone, so the answer is validated
+        /// normally.
+        /// </para>
+        /// </remarks>
         public DnsDatagram Query(DnsDatagram request, bool serveStale = false, bool findClosestNameServers = false, bool resetExpiry = false)
+        {
+            DnsDatagram response = QueryCache(request, serveStale, findClosestNameServers, resetExpiry);
+
+            if (response is null)
+                return null;
+
+            if (DnssecCachePolicy.HasExpiredNegativeTrustAnchor(response.Answer, response.Authority, response.Additional))
+                return null;
+
+            return response;
